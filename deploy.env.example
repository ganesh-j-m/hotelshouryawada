# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Database password (any long random string)
DB_PASSWORD=change-me-long-random

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-64-plus-random-characters

# Your server address. For a quick test use the EC2 public IP, e.g. http://13.234.10.20
SITE_URL=http://YOUR-SERVER-IP
CLIENT_ORIGIN=http://YOUR-SERVER-IP

# false ONLY while testing over plain http (IP address). Remove once you have https + a domain.
COOKIE_SECURE=false

# First owner login (created on first start only)
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_NAME=Hotel Owner
SEED_ADMIN_PASSWORD=ChangeMe2026
