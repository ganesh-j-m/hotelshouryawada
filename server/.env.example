# ─────────────────────────────────────────────────────────────
# Hotel Shauryawada — server environment (copy to .env)
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://shauryawada:change-me@localhost:5432/shauryawada?schema=public"

# Long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Admin session length
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins (frontend URLs)
CLIENT_ORIGIN=http://localhost:5173
# Public website URL — used for sitemap.xml, canonical URLs, robots.txt
SITE_URL=http://localhost:5173

# Set true when served over HTTPS in production (auto-true when NODE_ENV=production)
COOKIE_SECURE=false

# Image uploads (stored on disk, only the URL is saved in the database)
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE=/uploads
MAX_UPLOAD_MB=5

# Serve the built React app (client/dist) from this server — single-service deployment
SERVE_CLIENT=false

# First administrator — used ONLY by `npm run db:seed` / `npm run admin:create`
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_NAME=Hotel Owner
SEED_ADMIN_PASSWORD=change-this-strong-password
